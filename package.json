{
  "name": "agentic-engineer-bookmarks",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:search": "node scripts/build-search-index.mjs",
    "embed:new": "node scripts/embed-new.mjs",
    "embed:bge": "node scripts/embed-bge.mjs",
    "sync:bge": "node scripts/sync-bge.mjs",
    "upload:r2": "node scripts/upload-r2.mjs",
    "backfill:posters": "node scripts/backfill-posters.mjs",
    "eval:search": "node scripts/eval-search.mjs",
    "test:search": "node scripts/test-search-core.mjs",
    "test:operators": "node scripts/test-query-operators.mjs",
    "test:chat": "node --no-warnings scripts/test-chat-message.mjs",
    "test:autosync": "node scripts/test-autosync.mjs",
    "migrate:archive": "node scripts/migrate-to-archive.mjs",
    "sync": "node scripts/prepare-sync.mjs && xrelay archive bookmarks --out public/data/all-bookmarks.json --limit 10000 --threads && node scripts/backfill-articles.mjs && node scripts/sync-bge.mjs && node scripts/upload-r2.mjs",
    "prepare-sync": "node scripts/prepare-sync.mjs",
    "autosync": "node scripts/autosync.mjs",
    "autosync:run": "node scripts/auto-sync.mjs",
    "build": "next build",
    "start": "next start",
    "deploy:worker": "cd worker && ./node_modules/.bin/wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-invite": "node scripts/seed-invite.mjs",
    "add-invite": "node scripts/add-invite.mjs"
  },
  "dependencies": {
