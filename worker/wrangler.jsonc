{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookmark-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "ai": { "binding": "AI" },

  // Resolve the `@/*` specifiers used inside the shared lib/*.ts sources when they are
  // bundled into the Worker (esbuild does not read tsconfig `paths`). One entry per reachable
  // `@/` value-import; type-only imports (e.g. @/lib/bookmark-types) are erased but aliased
  // too for safety. Keeps one set of lib sources serving both the Next app and the Worker.
  "alias": {
    "@/lib/bookmark-search": "../lib/bookmark-search.ts",
    "@/lib/rerank-core": "../lib/rerank-core.ts",
    "@/lib/bookmark-types": "../lib/bookmark-types.ts",
    "@/scripts/lib/embed": "../scripts/lib/embed.mjs"
  },

  // PROD data source: the deployed Worker fetches the packed index + rerank docs + lunr index
  // from the Vercel static CDN (the files live in public/data/, served at /data). No R2 needed
  // for v1 — R2 is a future hardening option (loadData() prefers a SEARCH_DATA R2 binding over
  // DATA_BASE_URL if one is ever added). ALLOWED_ORIGINS pins CORS to the prod app origin.
  // DEV overrides DATA_BASE_URL to a local static server (http://localhost:8080/data) via
  // worker/.dev.vars (`cd public && python3 -m http.server 8080`), which wrangler dev reads in
  // preference to these vars.
  "vars": {
    "DATA_BASE_URL": "https://agentic-engineer-bookmarks.vercel.app/data",
    "ALLOWED_ORIGINS": "https://agentic-engineer-bookmarks.vercel.app"
  }
}
