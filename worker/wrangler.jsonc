{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookmark-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "ai": { "binding": "AI" },

  // Resolve the `@/*` specifiers used inside the shared lib/*.ts sources when they are
  // bundled into the Worker (esbuild does not read tsconfig `paths`). One entry per reachable
  // `@/` value-import; type-only imports (e.g. @/lib/bookmark-types) are erased but aliased
  // too for safety. Keeps one set of lib sources serving both the Next app and the Worker.
  "alias": {
    "@/lib/bookmark-search": "../lib/bookmark-search.ts",
    "@/lib/rerank-core": "../lib/rerank-core.ts",
    "@/lib/bookmark-types": "../lib/bookmark-types.ts",
    "@/scripts/lib/embed": "../scripts/lib/embed.mjs"
  },

  // PROD data source (T8): a PRIVATE R2 bucket holds ALL runtime data — the packed bge index
  // (.bin + .meta.json), rerank docs, lunr index, AND the raw bookmark archive (all-bookmarks.json,
  // served by GET /archive). fetchAsset() reads via this SEARCH_DATA binding; nothing is fetched
  // from Vercel anymore (public/data/* was removed from git + the CDN — see docs/SYNC-AND-DEPLOY.md).
  // There is deliberately NO prod DATA_BASE_URL: an R2 miss is a hard, visible error in prod.
  //
  // DEV: `wrangler dev` binds an EMPTY local R2 simulation, so fetchAsset misses and falls back to
  // DATA_BASE_URL from worker/.dev.vars (http://localhost:8080/data via `cd public && python3 -m
  // http.server 8080` — the data files still live on disk locally, just untracked/ungitignored).
  //
  // T4: /search + /archive are gated by SEARCH_PROXY_SECRET — a Worker SECRET, NOT a var. Set for
  // prod via `wrangler secret put SEARCH_PROXY_SECRET`, read locally from worker/.dev.vars; the
  // value must NEVER be committed here.
  "r2_buckets": [
    { "binding": "SEARCH_DATA", "bucket_name": "bookmark-search-data" }
  ]
}
